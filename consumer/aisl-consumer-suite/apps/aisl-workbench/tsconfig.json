{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "outDir": "public",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "aisl-sdk-typescript": [
        "public/vendor/aisl-sdk/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
