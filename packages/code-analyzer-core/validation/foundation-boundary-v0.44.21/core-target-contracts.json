  "contracts": {
    "evidence_analyzer": {
      "allowed_inputs": [
        "repository_or_source_snapshot",
        "declared Foundation sections",
        "analyzer-specific normalized parameters"
      ],
      "contract_id": "core_evidence_analyzer_contract/v1",
      "definition": "Public Core producer of one coherent source-grounded evidence family.",
      "forbidden_inputs": [
        "arbitrary shared AnalysisResult",
        "output of another public evidence analyzer",
        "task_id as evidence-semantic selector",
        "suite_id as evidence-semantic selector"
      ],
      "invariants": [
        "Analyzer output is deterministic for the same snapshot, Foundation fingerprint, version and evidence-affecting parameters.",
        "Analyzer result does not depend on execution order of other public analyzers.",
        "Source-understanding phases may depend on each other internally inside one analyzer.",
        "Cross-evidence composition and subject-model assembly belong to Knowledge Layer.",
        "Missing required inputs produce explicit diagnostics or failure; no hidden fallback to another analyzer."
      ],
      "owner": "code-analyzer-core",
      "required_outputs": [
        "typed evidence artifact",
        "coverage",
        "diagnostics",
        "provenance"
      ]
    },
    "evidence_artifact": {
      "contract_id": "core_evidence_artifact_contract/v1",
      "definition": "Self-describing persisted result of one independent Core evidence analyzer.",
      "forbidden_semantic_selectors": [
        "task_id",
        "suite_id",
        "report_profile_id"
      ],
      "invariants": [
        "KLC imports evidence by artifact_kind and schema_version, not by task_id.",
        "Artifact payload is independently consumable without reading another task directory.",
        "Coverage and diagnostics are part of the contract, not optional log files.",
        "Runtime-only values do not affect content_fingerprint.",
        "Unsupported schema versions fail explicitly; no silent reinterpretation."
      ],
      "owner": "code-analyzer-core",
      "required_fields": {
        "artifact_kind": "stable semantic evidence kind",
        "content_fingerprint": "canonical fingerprint excluding volatile runtime metadata",
        "contract_version": "core_evidence_artifact_contract/v1",
        "coverage": "machine-readable completeness and scope",
        "diagnostics": "explicit unresolved, ambiguous and failed observations",
        "foundation": {
          "contract_version": "core_foundation_contract/v1 when used",
          "fingerprint": "Foundation artifact fingerprint when used",
          "sections": "declared consumed sections, empty when not used",
          "used": "whether this analyzer consumed a Foundation artifact"
        },
        "parameters": "normalized evidence-affecting parameters",
        "payload": "typed evidence payload or artifact references",
        "producer": {
          "analyzer_id": "stable analyzer identifier",
          "analyzer_version": "producer implementation version",
          "component": "code-analyzer-core"
        },
        "provenance": "source references and production trace",
        "schema_version": "artifact payload schema version",
        "source_snapshot": {
          "fingerprint": "content or snapshot fingerprint",
          "revision": "revision when available",
          "source_id": "repository or source identifier"
        }
      },
      "semantic_identity": [
        "artifact_kind",
        "schema_version"
      ]
    },
    "evidence_runtime": {
      "contract_id": "core_evidence_runtime/v1",
      "definition": "Core-owned registry and executor for independent typed evidence analyzers selected by artifact_kind and schema_version.",
      "forbidden_behaviors": [
        "knowledge_id-specific dispatch",
        "task_id-specific dispatch",
        "profile_id-specific dispatch",
        "implicit publication from the monolithic analyze-java pipeline",
        "compatibility adapters for legacy prepared-artifact manifest keys"
      ],
      "invariants": [
        "Runtime dispatch is performed only by artifact_kind plus schema_version.",
        "Task, Suite, Profile and knowledge identifiers are not analyzer selectors.",
        "Every requested artifact must have exactly one registered analyzer.",
        "Analyzer results are validated against core_evidence_artifact_contract/v1 before publication.",
        "Missing registrations and invalid artifacts fail explicitly; legacy fallback and dual-write are forbidden."
      ],
      "owner": "code-analyzer-core",
      "request_schema_version": "core_evidence_execution_request/v1",
      "result_schema_version": "core_evidence_execution_result/v1",
      "semantic_identity": [
        "artifact_kind",
        "schema_version"
      ]
    },
