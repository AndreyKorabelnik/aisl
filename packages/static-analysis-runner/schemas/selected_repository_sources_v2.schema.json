{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "selected_repository_sources_v2.schema.json",
  "title": "Explicit selected repository sources with per-repository interaction identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repositories"
  ],
  "properties": {
    "schema_version": {
      "const": "selected_repository_sources/v2"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository_id",
          "path"
        ],
        "properties": {
          "repository_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "system_id": {
            "type": "string",
            "minLength": 1
          },
          "project_id": {
            "type": "string",
            "minLength": 1
          },
          "service_aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
